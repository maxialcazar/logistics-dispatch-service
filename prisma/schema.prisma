datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  role       Role
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
}

model Driver {
  id       String   @id @default(uuid())
  name     String
  users    User[]   // uno a muchos
  zones    Zone[]   @relation("DriverZones")
  packages Package[]
}

model Zone {
  id      String     @id @default(uuid())
  name    String
  drivers Driver[]   @relation("DriverZones")
  packages Package[]
}

model Package {
  id           String   @id @default(uuid())
  trackingCode String   @unique
  status       PackageStatus
  zone         Zone     @relation(fields: [zoneId], references: [id])
  zoneId       String
  driver       Driver?  @relation(fields: [driverId], references: [id])
  driverId     String?
}

enum Role {
  dispatcher
  driver
}

enum PackageStatus {
  pending
  assigned
  in_transit
  delivered
  cancelled
}
