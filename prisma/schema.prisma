datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType      = "client"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Identificador único para URLs o API (ej: "empresa-a")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relaciones
  users    User[]
  drivers  Driver[]
  zones    Zone[]
  packages Package[]
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  role       Role
  
  // Multi-Tenancy
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])

  driverId   String?  @unique
  driver     Driver?  @relation(fields: [driverId], references: [id])
  history    PackageHistory[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model Driver {
  id        String   @id @default(uuid())
  name      String
  lat       Float?
  lng       Float?
  
  // Multi-Tenancy
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  user      User?
  zones     Zone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model Zone {
  id      String     @id @default(uuid())
  name    String

  // Multi-Tenancy
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  driver   Driver?  @relation(fields: [driverId], references: [id])
  driverId String?

  packages Package[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model Package {
  id                  String   @id @default(uuid())
  trackingCode        String   // No longer globally unique
  address             String
  lat                 Float?
  lng                 Float?
  estimatedDeliveryAt DateTime?
  status              PackageStatus
  
  // Multi-Tenancy
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])

  zone                Zone     @relation(fields: [zoneId], references: [id])
  zoneId              String
  history             PackageHistory[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([companyId, status])        // Optimized for dashboard filtering
  @@index([companyId, zoneId])        // Optimized for zone-based lookups
  @@index([companyId, updatedAt])     // Optimized for incremental syncs
  @@unique([trackingCode, companyId]) // Composite unique constraint
}

model PackageHistory {
  id        String        @id @default(uuid())
  packageId String
  package   Package       @relation(fields: [packageId], references: [id])
  status    PackageStatus
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime      @default(now())

  // Optimized for chronological history view
  @@index([packageId, createdAt(sort: Desc)])
  @@index([userId])
}

enum Role {
  dispatcher
  driver
  admin     // Agregamos rol Admin para gestionar la empresa
}

enum PackageStatus {
  pending
  assigned
  in_transit
  delivered
  cancelled
}
