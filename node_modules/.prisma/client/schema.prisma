datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Identificador único para URLs o API (ej: "empresa-a")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relaciones
  users    User[]
  drivers  Driver[]
  zones    Zone[]
  packages Package[]
}

model User {
  id       String @id @default(uuid())
  // Explicit multi-tenant policy: username remains globally unique (@unique) because
  // POST /api/auth/login authenticates by { username, password } without companySlug,
  // and POST /api/auth/register-company enforces global username uniqueness (409).
  username String @unique
  password String
  role     Role

  // Multi-Tenancy
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  driverId  String?          @unique
  driver    Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  history   PackageHistory[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  @@index([companyId])
}

model Driver {
  id   String @id @default(uuid())
  name String
  lat  Float?
  lng  Float?

  // Multi-Tenancy
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  user      User?
  zones     Zone[]
  packages  Package[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([companyId])
}

model Zone {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(false)

  /// GeoJSON ring: array of [lng, lat] pairs forming a closed polygon.
  /// Example: [[-64.18, -31.41], [-64.17, -31.41], [-64.17, -31.40], [-64.18, -31.41]]
  polygon Json?

  // Multi-Tenancy
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?

  packages  Package[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, driverId])
}

model Package {
  id           String @id @default(uuid())
  trackingCode String // Código único visible (Barra/QR)

  // --- Destinatario (Recipient) ---
  recipientName     String
  recipientAddress  String // Dirección completa normalizada
  recipientPhone    String // Crítico para contacto
  recipientEmail    String?
  addressStreet     String?
  addressNumber     String?
  addressFloor      String? // Piso/Depto
  addressCity       String?
  addressZip        String?
  addressReferences String? // Referencias (Ej: "Portón negro, al lado del kiosco")

  // --- Remitente (Sender) - Opcional si es siempre la misma empresa ---
  senderName    String?
  senderAddress String?
  senderPhone   String?

  // --- Logística ---
  lat                 Float?
  lng                 Float?
  weight              Float? // Peso en kg
  volume              Float? // Volumen en m3
  estimatedDeliveryAt DateTime? // Fecha prometida
  deliveryWindowStart DateTime? // Ventana horaria inicio
  deliveryWindowEnd   DateTime? // Ventana horaria fin

  status PackageStatus @default(pending)

  // Multi-Tenancy
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneId String?

  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?

  history PackageHistory[]

  // --- Prueba de Entrega (Proof of Delivery) ---
  signatureUrl String? // URL local de la firma del receptor
  photoUrl     String? // URL local de la foto de evidencia

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([trackingCode, companyId])
  @@index([companyId, status])
  @@index([companyId, zoneId])
  @@index([companyId, driverId])
  @@index([companyId, updatedAt])
  @@index([companyId, isArchived, createdAt(sort: Desc)])
  @@index([trackingCode])
}

model PackageHistory {
  id        String        @id @default(uuid())
  packageId String
  package   Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status    PackageStatus
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime      @default(now())

  // Optimized for chronological history view
  @@index([packageId, createdAt(sort: Desc)])
  @@index([userId])
}

enum Role {
  dispatcher
  driver
  admin // Agregamos rol Admin para gestionar la empresa
}

enum PackageStatus {
  pending
  assigned
  in_transit
  delivered
  cancelled
}
